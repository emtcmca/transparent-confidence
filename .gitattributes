# Normalize line endings: Biome enforces LF; without this, Windows checkouts
# with core.autocrlf=true flag every .ts file as modified and fail lint.
* text=auto
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.png binary
*.svg text
