{
  "name": "transparent-confidence",
  "version": "0.3.0",
  "description": "Deterministic confidence scorecards for RAG systems with signal policy, calibration, evaluator bridges, and index integrity",
  "author": "Eric Tetzlaff",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "docs/algorithm-v0-2.md",
    "docs/migration-v0-2.md",
    "docs/algorithm-v0-3.md",
    "docs/migration-v0-3.md",
    "examples",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "rag",
    "retrieval-augmented-generation",
    "confidence",
    "scoring",
    "llm",
    "ai",
    "explainability",
    "evaluation",
    "ragas",
    "vector-search"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emtcmca/transparent-confidence.git"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --out-dir dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "biome check src/ tests/ examples/",
    "lint:fix": "biome check --write src/ tests/ examples/",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "verify:release": "npm run verify && npm run coverage && npm pack --dry-run && npm publish --dry-run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "^4.1.8",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
